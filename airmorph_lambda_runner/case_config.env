# Case identity used by AirMorph output filenames.
CASE_ID=target_clean_ct

# These files are populated by scripts/make_bundle.sh in the Lambda bundle.
CT_NRRD=case/input/target_clean_ct.nrrd
NETWORK_VTK='case/input/Network model.vtk'

# AirMorph checkout and environment.
AIRMORPH_REPO_URL=https://github.com/EndoluminalSurgicalVision-IMR/AirMorph.git
AIRMORPH_REF=main
AIRMORPH_DIR=AirMorph
CONDA_ENV=airwayatlas
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# Published by the AirMorph project README/checkpoints note.
CHECKPOINTS_DRIVE_FOLDER_ID=1T6VwUnHSkWzL7ghkImbWTqk6SGB-pan-

# Derived paths. Usually leave these alone.
AIRMORPH_CASE_GROUP=bronchoedu
OUTPUT_DIR=outputs/target_clean_ct
